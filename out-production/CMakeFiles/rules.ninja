#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = I:\PROJECTS\Apps\GameHQ\tools\cmake\bin\cmake.exe --regenerate-during-build -SI:\PROJECTS\Apps\GameHQ -BI:\PROJECTS\Apps\GameHQ\out-production
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning additional files.

rule CLEAN_ADDITIONAL
  command = I:\PROJECTS\Apps\GameHQ\tools\cmake\bin\cmake.exe -DCONFIG=$CONFIG -P CMakeFiles\clean_additional.cmake
  description = Cleaning additional files...


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = I:\PROJECTS\Apps\GameHQ\tools\Ninja\1.13.2\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = I:\PROJECTS\Apps\GameHQ\tools\Ninja\1.13.2\ninja.exe -t targets
  description = All primary targets available:

